WEBHOOK_SECRET=dev-webhook-secret
BOT_TOKEN=
# Initial login works with botpanel123 without ADMIN_PASSWORD.
# Set your private password in the first-login panel form.
# Optional override for an installation that prefers an environment password:
# ADMIN_PASSWORD=
# Optional production integrations (configure as secrets, not in source):
# ZARINPAL_MERCHANT_ID=
# MEDIA_PROCESSOR_URL=https://your-processor.example/process
# MEDIA_PROCESSOR_SECRET=
# PUBLIC_BASE_URL=https://your-v2-worker.workers.dev
# ZARINPAL_SANDBOX=false

# Services / VPN module: use a distinct strong Cloudflare secret in production.
# VAULT_KEY=<at-least-32-random-characters>
# Optional nightly encrypted R2 backups:
# BACKUP_PASSWORD=<at-least-12-characters>
